{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lisalix",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
